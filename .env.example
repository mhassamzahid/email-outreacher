# Copy to .env.local for local development. On Vercel, set these as environment variables instead.
# All three are public (they're sent to the browser), so no secrets belong here.

# The backend (FastAPI). Defaults to http://localhost:8000 when empty.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase, for signing in: the project URL and its publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
